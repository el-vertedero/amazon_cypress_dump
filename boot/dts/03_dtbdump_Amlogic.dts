		compatible = "amazon,thermal_cooler";
		#cooling-cells = <0x02>;
		max_state = <0x08>;
	};

	picdec {
		compatible = "amlogic, picdec";
		status = "okay";
	};

	ppmgr {
		compatible = "amlogic, ppmgr";
		memory-region = <0xb6>;
		dev_name = "ppmgr";
		status = "okay";
	};

	video_queue {
		compatible = "amlogic, video_queue";
		dev_name = "videoqueue";
		status = "okay";
	};

	amdolby_vision {
		compatible = "amlogic, dolby_vision_t7";
		dev_name = "aml_amdolby_vision_driver";
		status = "disabled";
		tv_mode = <0x00>;
	};

	ionvideo {
		compatible = "amlogic, ionvideo";
		dev_name = "ionvideo";
		status = "okay";
	};

	amlvideo2_0 {
		compatible = "amlogic, amlvideo2";
		dev_name = "amlvideo2";
		status = "okay";
		amlvideo2_id = <0x00>;
		cma_mode = <0x01>;
	};

	amlvideo2_1 {
		compatible = "amlogic, amlvideo2";
		dev_name = "amlvideo2";
		status = "okay";
		amlvideo2_id = <0x01>;
		cma_mode = <0x01>;
	};

	adc_keypad {
		compatible = "amlogic, adc_keypad";
		status = "disabled";
		key_name = "update\0vol-\0vol+\0enter";
		key_num = <0x04>;
		io-channels = <0xb5 0x02>;
		io-channel-names = "key-chan-2";
		key_chan = <0x02 0x02 0x02 0x02>;
		key_code = <0x8d 0x72 0x73 0x1c>;
		key_val = <0x00 0x8f 0x10a 0x185>;
		key_tolerance = <0x28 0x28 0x28 0x28>;
	};

	gpio-keys {
		status = "okay";
		compatible = "gpio-keys";
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		volume1 {
			label = "Volume button 1";
			debounce-interval = <0x14>;
			gpios = <0x2d 0x8a 0x01>;
			linux,input-type = <0x01>;
			linux,code = <0x73>;
			phandle = <0xba>;
		};

		volume2 {
			label = "Volume button 2";
			debounce-interval = <0x14>;
			gpios = <0x2d 0x89 0x01>;
			linux,input-type = <0x01>;
			linux,code = <0x72>;
			phandle = <0xb8>;
		};

		camera_lens_cover {
			label = "Camera Lens Cover";
			debounce-interval = <0x32>;
			gpios = <0x2d 0x30 0x01>;
			linux,input-type = <0x05>;
			linux,code = <0x09>;
		};
	};

	gpio-privacy {
		compatible = "gpio-privacy";
		status = "okay";
		enable-gpio = <0xb7 0x07 0x00>;
		enable-gpio-toggle-duration = <0x3e8>;
		auto-toggle-enable-gpio-time = <0x32>;
		privacy-event-max-press-duration = <0xbb8>;

		state_event {
			label = "mute state";
			linux,input-type = <0x05>;
			linux,code = <0x0e>;
			gpios = <0xb7 0x04 0x01>;
		};

		button_event {
			label = "mute button";
			linux,input-type = <0x01>;
			linux,code = <0x74>;
			debounce-interval = <0x32>;
			wakeup-source;
			gpios = <0xb7 0x03 0x01>;
			phandle = <0xbc>;
		};
	};

	amazon,keys {
		compatible = "amazon,input-key-profiles";
		status = "okay";

		amazon,function-keys {

			amazon,k0 {
				label = "voldown";
				linux,code = <0x72>;
				phandle = <0xb9>;
			};

			amazon,k1 {
				label = "volup";
				linux,code = <0x73>;
				phandle = <0xbb>;
			};

			amazon,k2 {
				label = "power";
				linux,code = <0x74>;
				phandle = <0xbd>;
			};
		};

		amazon,key-profiles {

			amazon,p0 {
				label = "default";
				amazon,key-map = <0xb8 0xb9 0xba 0xbb 0xbc 0xbd>;
			};

			amazon,p1 {
				label = "landscape";
				amazon,key-map = <0xb8 0xbb 0xba 0xb9 0xbc 0xbd>;
			};

			amazon,p2 {
				label = "portrait";
				amazon,key-map = <0xb8 0xb9 0xba 0xbb 0xbc 0xbd>;
			};
		};

		amazon,key-profiles-fixup {
			amazon,idme-name = "productid2";
			amazon,idme-value = "volume-keys=chevrons";
		};
	};

	keycombo@0 {
		compatible = "amazon,keycombo";
		keys_down = "KEY_VOLUMEDOWN\0KEY_POWER";
		keys_down_delay = <0x2328>;
		keys_down_func = <0x00>;
		status = "okay";
	};

	keycombo@1 {
		compatible = "amazon,keycombo";
		keys_down = "KEY_POWER";
		keys_down_delay = <0x2af8>;
		keys_down_func = <0x01>;
		status = "okay";
	};
};
