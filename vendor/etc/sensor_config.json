/*
 * Refer to wiki link:
 * https://wiki.labcollab.net/confluence/display/Doppler/How+to+write+sensor_config.json+file
 * for how to write sensor_config.json file
 */

{
    "sensorDevice": [{
            "sensorName": "tcs3400_als",
            "vendorName": "AMS",
            "type": "rgbw",
            "resolution": 0.01,
            "minDelay": 700000,
            "isVirtual": false,
            "inputSysPath": "/sys/devices/virtual/input",
            "channelNames": [
                "als_red",
                "als_green",
                "als_blue",
                "als_clear",
                "als_itime",
                "als_gain"
            ],
            "needsEnable": true,
            "enablePairs": [{
                "name": "als_enable",
                "value": "1"
            },
            {
                /* change to use clear channel */
                "name": "ir_toggle_mode",
                "value": "0"
            }
            ],
            "needsRefresh": false,
            "needsParsing": false
        },
        {
            "sensorName": "bma4xy_acc_3_18",
            "vendorName": "BOSCH",
            "type": "accel",
            "resolution": 0.01,
            "minDelay": 40000,
            "isVirtual": false,
            "inputSysPath": "/sys/devices/virtual/input",
            "channelNames": [
                "acc_value"
            ],
            "needsEnable": true,
            "enablePairs": [
                {
                    "name": "load_config_stream",
                    "value": "3"
                },
                /* odr 25Hz */
                {
                    "name": "acc_odr",
                    "value": "6"
                },
                /* g-range +/-2g */
                {
                    "name": "acc_range",
                    "value": "0"
                },
                /* OSR2 mode */
                {
                    "name": "acc_bw",
                    "value": "1"
                },
                /* enable */
                {
                    "name": "acc_op_mode",
                    "value": "0"
                }
            ],
            /* wait 600ms after enabling */
            "enableWaitTimeUs": 600000,
            "needsRefresh": false,
            "needsParsing": true,
            "finalChannels": 3,
            "needsScale": true,
            /* Convert to ms2 format GRAVITY_EARTH/SENSITIVITY_2G = 9.81/16384 */
            "channelScaleValues": [0.00059857]
        },
        {
            "sensorName": "virtual_als",
            "vendorName": "Amazon",
            "type": "light",
            "resolution": 0.01,
            "isVirtual": true,
            "baseSensor": [
                0
            ]
        }
    ]
}
