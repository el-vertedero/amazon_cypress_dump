# This rc file is applicable only to fos7.
# For fos6, see product specific rc scripts.
on post-fs-data
    mkdir /data/alexahybrid                         0777 vendor_ahe vendor_ahe
    mkdir /data/alexahybrid/files                   0777 vendor_ahe vendor_ahe
    mkdir /data/alexahybrid/files/AmWorking         0777 vendor_ahe vendor_ahe
    mkdir /data/alexahybrid/files/AmModel           0777 vendor_ahe vendor_ahe
    mkdir /data/alexahybrid/files/CoreEngineWorking 0777 vendor_ahe vendor_ahe
    mkdir /data/alexahybrid/files/smartHomeSkill    0777 vendor_ahe vendor_ahe
    mkdir /data/alexahybrid/files/working-directory 0777 vendor_ahe vendor_ahe
    mkdir /data/alexahybrid/ec-sockets              0777 vendor_ahe vendor_ahe
    mkdir /data/alexahybrid/ps-sockets              0777 vendor_ahe vendor_ahe
    mkdir /data/alexahybrid/lsf-sockets             0777 vendor_ahe vendor_ahe
    mkdir /data/alexahybrid/lro-sockets             0777 vendor_ahe vendor_ahe
    setprop persist.litespeed.supported 1

service ahe /system/bin/start_ahe.sh -c /system/bin/AlexaHybridExecutionControllerLitespeed
    class main
    user vendor_ahe
    group vendor_ahe dbus inet vendor_amazon_gid

