<permissions>

    <!-- These are the feature flags relevant to all multimodal devices -->

    <!-- feature to distinguish multimodal devices from other amazon devices -->
    <feature name="com.amazon.hardware.multimodal"/>

    <!-- feature to enable YouTube device authentication -->
    <feature name="com.amazon.feature.no_starboard_enabled"/>

    <!-- feature to enable supporting device policy enforcement via device admins -->
    <!-- KnightSettings requires this permission for setCameraDisabled -->
    <feature name="android.software.device_admin"/>

</permissions>
